# Chave da IA (NVIDIA Nemotron): cria grátis em https://build.nvidia.com
NVIDIA_API_KEY=
# Modelo (vê os disponíveis em build.nvidia.com > Nemotron)
AI_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# Para usar outro serviço compatível com a OpenAI, muda o endereço:
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
PORT=3000
# Põe 1 quando o site estiver em https (ex: Cloudflare Tunnel)
HTTPS=0
