# ---- Obrigatório ----
# Palavra-passe do teu painel (/admin)
ADMIN_PASSWORD=muda-isto-para-algo-forte

# Supabase: Project Settings → Database → Connection string → "Session pooler" (URI)
# Exemplo: postgresql://postgres.abcdefgh:[A-TUA-SENHA]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---- IA (opcional) ----
# Chave grátis em https://build.nvidia.com (Nemotron)
NVIDIA_API_KEY=
AI_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# AI_BASE_URL=https://integrate.api.nvidia.com/v1

# ---- Servidor ----
PORT=3000
# Põe 1 quando o site estiver em https (ex: Cloudflare Tunnel)
HTTPS=0
# Opcional: segredo das sessões do painel (se não definires, deriva da palavra-passe)
SESSION_SECRET=
